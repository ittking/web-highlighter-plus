{
  "name": "web-highlighter-plus",
  "version": "1.0.2",
  "description": "A modern TypeScript library for text highlighting and serialization",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "highlight",
    "text-selection",
    "range",
    "serialization",
    "highlighter"
  ],
  "author": "ittking",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ittking/web-highlighter-plus.git"
  },
  "homepage": "https://github.com/ittking/web-highlighter-plus",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
